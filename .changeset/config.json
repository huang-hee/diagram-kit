{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "baseBranch": "main",
  "access": "restricted",
  "format": "auto",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "ignore": [],
  "fixed": [],
  "linked": [],
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": true
  },
  "changedFilePatterns": [
    "**",
    ".*",
    ".*/**",
    "!README.md",
    "!CHANGELOG.md",
    "!LICENSE",
    "!package.json",
    "!package-lock.json",
    "!.changeset/**",
    "!.scripts/**",
    "!.gitignore"
  ]
}
