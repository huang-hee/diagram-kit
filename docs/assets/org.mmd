---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart TB
  CEO[总经理]:::top --> CTO[技术中心]:::l2
  CEO --> COO[运营中心]:::l2
  CEO -.-> AS[总经理助理]:::aux
  CTO --> FE[前端组]:::l3
  CTO --> BE[后端组]:::l3
  COO --> OP[内容运营]:::l3
classDef top fill:#3B6FC2,stroke:#3B6FC2,color:#FFFFFF,stroke-width:2px
classDef l2 fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef l3 fill:#FFFFFF,stroke:#3B6FC2,color:#33384A
classDef aux fill:#EEEFF0,stroke:#8F929B,color:#33384A,stroke-dasharray:5 4
%% 用法：节点 A:::top 或 class A,B top
