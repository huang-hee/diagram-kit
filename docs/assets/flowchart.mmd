---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart LR
  A([提交订单]):::startend --> B{库存充足?}:::decision
  B -- 否 --> X[提示缺货]:::error
  B -- 是 --> C[锁定库存]:::process
  C --> D[(订单库)]:::data
  C --> E[发起支付]:::key
  E --> Z([结束]):::startend
  X --> Z
classDef startend fill:#FBDBD1,stroke:#B09992,color:#712A14
classDef process fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef decision fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
classDef data fill:#D8F0ED,stroke:#97A8A6,color:#256058
classDef key fill:#3B6FC2,stroke:#3B6FC2,color:#FFFFFF,stroke-width:2px
classDef error fill:#FAE0DD,stroke:#E35144,color:#33384A
%% 用法：节点 A:::startend 或 class A,B startend
