---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart TB
  S(( )):::bar --> A[接收订单]:::action
  A --> D{库存足够?}:::decision
  D -- 是 --> F[发货]:::action
  D -- 否 --> O[/缺货单/]:::object
  F --> E(( )):::bar
  O --> E
classDef action fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef decision fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
classDef object fill:#D8F0ED,stroke:#97A8A6,color:#256058
classDef bar fill:#33384A,stroke:#33384A,color:#FFFFFF
classDef partition fill:#EBF1F9,stroke:#3B6FC2,color:#33384A
%% 用法：节点 A:::action 或 class A,B action
