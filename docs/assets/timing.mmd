---
title: "支付请求的状态变化"
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  flowchart:
    curve: "step"
    nodeSpacing: 50
    rankSpacing: 60
    padding: 12
    wrappingWidth: 300
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart LR
  A["空闲<br><small>0–1s</small>"]:::s1 --> B["处理中<br><small>1–3s</small>"]:::s2 --> C["等待回调<br><small>3–5s</small>"]:::s3 --> D["空闲<br><small>5s 起</small>"]:::s1
%% 该图 Mermaid 没有原生类型，优先用 drawio；下面是 flowchart 近似画法的配色
classDef lifeline fill:#EBF1F9,stroke:#3B6FC2,color:#33384A,rx:8,ry:8
classDef s1 fill:#EDEFF9,stroke:#D2D6F1,color:#33384A,rx:8,ry:8
classDef s2 fill:#FDF1ED,stroke:#FBDBD1,color:#33384A,rx:8,ry:8
classDef s3 fill:#E1EAE9,stroke:#D8F0ED,color:#33384A,rx:8,ry:8
classDef axis fill:#EEEFF0,stroke:#8F929B,color:#33384A,rx:8,ry:8
%% 用法：节点 A:::lifeline 或 class A,B lifeline
linkStyle default stroke-width:1.5px
