    SW[核心交换机]:::device
    APP[应用服务器]:::server
  end
  FW --> WAF --> NG --> SW --> APP
  class DMZ dmz
  class IN intranet
classDef internet fill:#EEEFF0,stroke:#8F929B,color:#33384A
classDef dmz fill:#FBEEE2,stroke:#E8A35D,color:#33384A
classDef intranet fill:#EBF1F9,stroke:#3B6FC2,color:#33384A
classDef device fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef server fill:#FFFFFF,stroke:#3B6FC2,color:#33384A
