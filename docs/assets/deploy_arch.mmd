---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart TB
  subgraph AZ[华东可用区 VPC]
    LB[负载均衡 SLB]:::gateway
    subgraph K8S[K8s 集群]
      GW[网关 x2]:::node
      OD[订单服务 x3]:::node
    end
    DB[(MySQL 一主一从)]:::db
  end
  FW[WAF]:::security --> LB
  LB --> GW --> OD --> DB
  class AZ zone
  class K8S subnet
classDef zone fill:#FFFFFF,stroke:#3B6FC2,color:#33384A,stroke-dasharray:5 4
classDef subnet fill:#EBF1F9,stroke:#3B6FC2,color:#33384A
classDef node fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef gateway fill:#FBDBD1,stroke:#B09992,color:#712A14
classDef db fill:#D8F0ED,stroke:#97A8A6,color:#256058
classDef security fill:#FAE0DD,stroke:#E35144,color:#33384A
%% 用法：节点 A:::zone 或 class A,B zone
