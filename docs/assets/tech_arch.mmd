---
block-beta
  columns 4
  L1["接入"]:1 a["CDN、Nginx"]:3
  L2["服务"]:1 b["Spring Boot"] c["Spring Cloud"] d["Dubbo"]
  L3["数据"]:1 e["MySQL"] f["Redis"] g["Elasticsearch"]
  L4["运维"]:1 h["日志"] i["监控告警"] j["CI/CD"]
  class L1,L2,L3,L4 layer
  class a,b,c,d,e,f,g item
  class h,i,j cross
  class f highlight
classDef layer fill:#3B6FC2,stroke:#3B6FC2,color:#FFFFFF,stroke-width:2px
classDef item fill:#FFFFFF,stroke:#3B6FC2,color:#33384A
classDef cross fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
classDef highlight fill:#FBDBD1,stroke:#B09992,color:#712A14
%% 用法：class a,b capability（block-beta 里写在块定义之后）
