---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
swimlane-beta LR
  subgraph U[用户]
    A([提交退款]):::startend
    F([收到退款]):::startend
  end
  subgraph S[客服]
    B{是否符合规则?}:::decision
    C[人工审核]:::task
  end
  subgraph P[财务]
    D[原路退款]:::handoff
  end
  A --> B
  B -- 是 --> D
  B -- 否 --> C --> D
  D --> F
  class U,S,P lane
classDef startend fill:#FBDBD1,stroke:#B09992,color:#712A14
classDef task fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef decision fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
classDef handoff fill:#3B6FC2,stroke:#3B6FC2,color:#FFFFFF,stroke-width:2px
classDef lane fill:#EBF1F9,stroke:#3B6FC2,color:#33384A
%% 用法：节点 A:::startend 或 class A,B startend
