    usecaseExtendLine: "#3B6FC2"
---
usecase-beta
  direction LR
  actor Customer("顾客")
  systemBoundary "电商系统"
    Browse("浏览商品"):::uc
    Order("下单"):::uc
    Coupon("使用优惠券"):::ext
  end
  Customer --> Browse
  Customer --> Order
  Coupon ..> : extend Order
classDef person fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
classDef uc fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef ext fill:#FBDBD1,stroke:#B09992,color:#712A14
classDef boundary fill:#FFFFFF,stroke:#3B6FC2,color:#33384A,stroke-dasharray:5 4
%% 用法：Order("下单"):::ext、actor Admin("管理员"):::person；systemBoundary 也能挂 :::boundary；class 名不能用 actor 这类关键字
