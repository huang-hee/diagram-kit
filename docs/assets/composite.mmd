---
config:
  theme: base
  fontFamily: "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif"
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#FFFFFF"
    primaryBorderColor: "#3B6FC2"
    primaryTextColor: "#33384A"
    nodeTextColor: "#33384A"
    secondaryColor: "#FBDBD1"
    tertiaryColor: "#EBF1F9"
    lineColor: "#3B6FC2"
    textColor: "#33384A"
    clusterBkg: "#EBF1F9"
    clusterBorder: "#3B6FC2"
    edgeLabelBackground: "#FFFFFF"
    titleColor: "#33384A"
    noteBkgColor: "#FFF6CE"
    noteBorderColor: "#A6A086"
    noteTextColor: "#33384A"
---
flowchart LR
  subgraph CAR[Car]
    E[engine : Engine]:::part
    W[wheels : Wheel 4]:::part
    P1((p)):::port
  end
  E --- W
  P1 --- E
  class CAR frame
classDef frame fill:#FFFFFF,stroke:#3B6FC2,color:#33384A,stroke-dasharray:5 4
classDef part fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef port fill:#F6DEB6,stroke:#AC9B7F,color:#714E14
%% 用法：节点 A:::frame 或 class A,B frame
