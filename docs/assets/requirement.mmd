---
requirementDiagram
  requirement order_req {
    id: R1
    text: "用户可提交订单"
    risk: high
    verifymethod: test
  }
  element order_api {
    type: code
  }
  order_api - satisfies -> order_req
  class order_api element
classDef req fill:#D2D6F1,stroke:#9396A9,color:#1F2865
classDef element fill:#D8F0ED,stroke:#97A8A6,color:#256058
%% element 的配色：classDef 后 class 元素名 element
