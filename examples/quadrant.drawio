        </mxCell>
        <mxCell id="v49" value="&lt;b style=&quot;font-size:13px&quot;&gt;编号对照&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;A  自助重置密码　V 4.3 / E 1.5&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;B  工单超时提醒　V 3.6 / E 2.5&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;C  单点登录　V 4.2 / E 3.6&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;D  跨系统审批　V 3.8 / E 4.4&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;E  通知文案优化　V 2.3 / E 1.6&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;F  列表排序　V 1.6 / E 2.4&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;G  全站动效改版　V 2.4 / E 3.6&lt;/div&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;H  多主题皮肤　V 1.4 / E 4.5&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif;fontSize=12;fontColor=#33384A;spacing=0;" vertex="1" parent="1">
